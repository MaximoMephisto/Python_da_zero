<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="esercizio_while"/>
        <attribute name="authors" value="maxxi"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-05-20 02:46:34 "/>
        <attribute name="created" value="bWF4eGk7QlJBSU5fUEM7MjAyNi0wNS0yMDsiMDI6MjE6NDkgIjsyMzQ3"/>
        <attribute name="edited" value="bWF4eGk7QlJBSU5fUEM7MjAyNi0wNS0yMDsiMDI6NDY6MzQgIjsxOzI0NTY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, numRiserva" type="Integer" array="False" size=""/>
            <output expression="&quot;Inserisci un numero:&quot;" newline="True"/>
            <input variable="num1"/>
            <assign variable="numRiserva" expression="0"/>
            <while expression="num1 != -1">
                <assign variable="numRiserva" expression="numRiserva + num1"/>
                <output expression="&quot;Inserisci un numero:&quot;" newline="True"/>
                <input variable="num1"/>
            </while>
            <output expression="numRiserva" newline="True"/>
        </body>
    </function>
</flowgorithm>
